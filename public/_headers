# Cloudflare static-assets headers (copied to out/_headers by `next build`).

# Fingerprinted build output never changes: cache for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Link-preview images (src/app/[lang]/opengraph-image.tsx) are exported without an extension.
/pt/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400
/en/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400
